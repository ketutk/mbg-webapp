generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum GameStatus {
  QUEUED
  ON_COURT
  DONE
}

enum TeamSide {
  A
  B
}

enum EntryType {
  INCOME
  EXPENSE
}

model User {
  id             String      @id @default(cuid())
  username       String      @unique
  passwordHash   String
  role           Role        @default(ADMIN)
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  deletedAt      DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tokens         AuthToken[]
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id          String        @id @default(cuid())
  name        String
  date        DateTime      @db.Date
  courtCount  Int           @default(1)
  status      SessionStatus @default(OPEN)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  players     Player[]
  games       Game[]

  @@index([date])
  @@index([status, date])
}

model Player {
  id        String       @id @default(cuid())
  sessionId String
  name      String
  nameKey   String
  position  Int
  paid      Boolean      @default(false)
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  games     GamePlayer[]

  @@unique([sessionId, nameKey])
}

model Game {
  id          String       @id @default(cuid())
  sessionId   String
  seq         Int
  status      GameStatus
  courtNumber Int?
  queueOrder  Int?
  scoreA      Int?
  scoreB      Int?
  locked      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  players     GamePlayer[]

  @@unique([sessionId, seq])
  @@unique([sessionId, courtNumber])
  @@index([sessionId, status])
}

model GamePlayer {
  gameId   String
  playerId String
  team     TeamSide?
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([gameId, playerId])
}

model TreasuryCategory {
  id          String          @id @default(cuid())
  name        String
  nameKey     String          @unique
  type        EntryType?
  isSystem    Boolean         @default(false)
  createdById String?
  createdAt   DateTime        @default(now())
  entries     TreasuryEntry[]

  @@index([type])
}

model TreasuryEntry {
  id          String            @id @default(cuid())
  type        EntryType         @default(EXPENSE)
  amount      Int
  purpose     String
  date        DateTime          @db.Date
  categoryId  String?
  category    TreasuryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdById String
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([categoryId])
}

model ClubSettings {
  id          String   @id @default("default")
  schedule    String   @default("Sundays")
  venue       String   @default("Local badminton court")
  skillLevel  String   @default("All levels, beginner to intermediate doubles")
  whatsappUrl String?
  ayoUrl      String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}
