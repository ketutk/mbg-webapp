generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum GameStatus {
  QUEUED
  ON_COURT
  DONE
}

enum TeamSide {
  A
  B
}

enum EntryType {
  INCOME
  EXPENSE
}

model User {
  id             String      @id @default(cuid())
  username       String      @unique
  passwordHash   String
  role           Role        @default(ADMIN)
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  deletedAt      DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tokens         AuthToken[]
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  date        DateTime      @db.Date
  courtCount  Int           @default(1)
  status      SessionStatus @default(OPEN)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  players     Player[]
  games       Game[]
  tournaments Tournament[]

  @@index([date])
  @@index([status, date])
}

model Player {
  id                 String           @id @default(cuid())
  sessionId          String
  name               String
  nameKey            String
  position           Int
  paid               Boolean          @default(false)
  tier               Int?
  session            Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  games              GamePlayer[]
  tournamentTeamsAs1 TournamentTeam[] @relation("TournamentTeamPlayer1")
  tournamentTeamsAs2 TournamentTeam[] @relation("TournamentTeamPlayer2")

  @@unique([sessionId, nameKey])
}

model Game {
  id              String           @id @default(cuid())
  sessionId       String
  seq             Int
  status          GameStatus
  courtNumber     Int?
  queueOrder      Int?
  scoreA          Int?
  scoreB          Int?
  locked          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  players         GamePlayer[]
  tournamentMatch TournamentMatch?

  @@unique([sessionId, seq])
  @@unique([sessionId, courtNumber])
  @@index([sessionId, status])
}

model GamePlayer {
  gameId   String
  playerId String
  team     TeamSide?
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([gameId, playerId])
}

model TreasuryCategory {
  id          String          @id @default(cuid())
  name        String
  nameKey     String          @unique
  type        EntryType?
  isSystem    Boolean         @default(false)
  createdById String?
  createdAt   DateTime        @default(now())
  entries     TreasuryEntry[]

  @@index([type])
}

model TreasuryEntry {
  id          String            @id @default(cuid())
  type        EntryType         @default(EXPENSE)
  amount      Int
  purpose     String
  date        DateTime          @db.Date
  categoryId  String?
  category    TreasuryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdById String
  updatedById String?
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([categoryId])
}

model ClubSettings {
  id          String   @id @default("default")
  schedule    String   @default("Sundays")
  venue       String   @default("Local badminton court")
  skillLevel  String   @default("All levels, beginner to intermediate doubles")
  whatsappUrl String?
  ayoUrl      String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model PlayerTier {
  nameKey     String   @id
  displayName String
  tier        Int
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum TournamentFormat {
  SINGLE_ELIMINATION
}

enum TournamentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum TournamentTeamStatus {
  ACTIVE
  ELIMINATED
  CHAMPION
}

enum TournamentMatchStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  BYE
}

enum BracketSection {
  MAIN
  THIRD_PLACE
}

model Tournament {
  id              String            @id @default(cuid())
  slug            String            @unique
  sessionId       String
  name            String
  format          TournamentFormat  @default(SINGLE_ELIMINATION)
  status          TournamentStatus  @default(DRAFT)
  hasThirdPlace   Boolean           @default(false)
  preferredCourts Int[]             @default([])
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  session         Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teams           TournamentTeam[]
  matches         TournamentMatch[]

  @@index([sessionId])
  @@index([status])
}

model TournamentTeam {
  id           String               @id @default(cuid())
  tournamentId String
  name         String?
  seed         Int
  player1Id    String
  player2Id    String
  status       TournamentTeamStatus @default(ACTIVE)
  eliminatedAt DateTime?

  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1      Player               @relation("TournamentTeamPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2      Player               @relation("TournamentTeamPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)

  matchesAsA   TournamentMatch[]    @relation("MatchTeamA")
  matchesAsB   TournamentMatch[]    @relation("MatchTeamB")
  matchesWon   TournamentMatch[]    @relation("MatchWinner")

  @@unique([tournamentId, seed])
  @@index([tournamentId, status])
}

model TournamentMatch {
  id               String                @id @default(cuid())
  tournamentId     String
  section          BracketSection        @default(MAIN)
  round            Int
  slot             Int
  playOrder        Int?
  label            String?
  status           TournamentMatchStatus @default(PENDING)

  teamAId          String?
  teamBId          String?
  winnerTeamId     String?
  isWalkover       Boolean               @default(false)

  gameId           String?               @unique

  nextMatchId      String?
  nextMatchSlot    TeamSide?
  loserNextMatchId String?
  loserNextSlot    TeamSide?

  tournament       Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA            TournamentTeam?       @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB            TournamentTeam?       @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  winnerTeam       TournamentTeam?       @relation("MatchWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  game             Game?                 @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, section, round, slot])
  @@index([tournamentId, status])
}
